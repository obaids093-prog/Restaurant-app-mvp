# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source text types
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary asset files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.ico binary
*.pdf binary
*.ttf binary
