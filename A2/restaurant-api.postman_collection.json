{
  "info": {
    "_postman_id": "a92e6f42-498c-4a39-9d78-b19e9f9024f8",
    "name": "AURA Restaurant API (Assignment 2)",
    "description": "Complete Postman collection for CS / MAD Assignment 2 backend covering Authentication, Menu CRUD, Orders with status state machine, Tables, and Table Reservations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "manager_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sample_item_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as Customer (Zainab)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('customer_token', res.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"zainab.malik@aurabistro.pk\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as Manager (Chef Farhan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('manager_token', res.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farhan.chef@aurabistro.pk\",\n  \"password\": \"Admin1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Register New User (201 Created)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Khan\",\n  \"email\": \"ali.khan@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"0300-1122334\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.4 Register Duplicate Email (409 Conflict - Expected Fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"zainab.malik@aurabistro.pk\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.5 Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Menu Endpoints",
      "item": [
        {
          "name": "2.1 Get All Menu Items (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (Array.isArray(res) && res.length > 0) { pm.collectionVariables.set('sample_item_id', res[0]._id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "2.2 Filter Menu by Category (?category=Mains)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu?category=Mains",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"],
              "query": [{ "key": "category", "value": "Mains" }]
            }
          }
        },
        {
          "name": "2.3 Search Menu Items (?search=lobster)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu?search=lobster",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"],
              "query": [{ "key": "search", "value": "lobster" }]
            }
          }
        },
        {
          "name": "2.4 Get Single Item by Valid ID (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu/{{sample_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "{{sample_item_id}}"]
            }
          }
        },
        {
          "name": "2.5 Get Item by Invalid ID Format (400 Bad Request - Expected Fail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu/invalid_mongo_id_123",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "invalid_mongo_id_123"]
            }
          }
        },
        {
          "name": "2.6 Get Item Non-Existent ID (404 Not Found - Expected Fail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/menu/600000000000000000000000",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "600000000000000000000000"]
            }
          }
        },
        {
          "name": "2.7 Add Item Without Token (401 Unauthorized - Expected Fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Unauthorized Item\",\n  \"description\": \"Should fail\",\n  \"price\": 1200,\n  \"category\": \"Starters\",\n  \"image\": \"https://images.unsplash.com/photo-1547592166-23ac45744acd\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "2.8 Add Item With Customer Token (403 Forbidden - Expected Fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Created Item\",\n  \"description\": \"Customer should not be able to create items\",\n  \"price\": 1200,\n  \"category\": \"Starters\",\n  \"image\": \"https://images.unsplash.com/photo-1547592166-23ac45744acd\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "2.9 Add Item With Negative Price (400 Bad Request - Expected Fail)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Negative Price Dish\",\n  \"description\": \"Invalid price validation\",\n  \"price\": -500,\n  \"category\": \"Starters\",\n  \"image\": \"https://images.unsplash.com/photo-1547592166-23ac45744acd\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "2.10 Add Item With Manager Token (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handcrafted Truffle Gnocchi\",\n  \"description\": \"Piedmontese soft potato gnocchi tossed in white truffle butter and aged parmigiano-reggiano.\",\n  \"price\": 2250,\n  \"category\": \"Mains\",\n  \"image\": \"https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=600\",\n  \"isSpecial\": true,\n  \"isAvailable\": true,\n  \"prepTime\": \"18 min\",\n  \"rating\": 4.9,\n  \"tag\": \"Chef Special\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "2.11 Update Menu Item (200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1550,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu/{{sample_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "{{sample_item_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders Endpoints",
      "item": [
        {
          "name": "3.1 Place Order (201 Created - Server Recalculates Total)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"menuItem\": \"{{sample_item_id}}\",\n      \"quantity\": 2,\n      \"specialInstructions\": \"Warm bread on side\"\n    }\n  ],\n  \"orderType\": \"Dine-in\",\n  \"tableNumber\": \"A-01\",\n  \"notes\": \"Anniversary dinner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "3.2 Get Customer My Orders (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/my",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "my"]
