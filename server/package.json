{
  "name": "restaurant-server",
  "version": "1.0.0",
  "description": "Backend server for AURA Restaurant App - A2 Assignment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js server.js",
    "seed": "node seed.js",
    "seed:demo": "node seedDemo.js",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,json}\"",
    "check": "npm run lint && node node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,json}\"",
    "test": "node node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
