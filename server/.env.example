# Port number for Express REST API server (default: 5000)
PORT=5000

# Node runtime environment mode: development, production, or test (default: development)
NODE_ENV=development

# MongoDB Atlas or local MongoDB connection URI string (REQUIRED)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT tokens (REQUIRED)
JWT_SECRET=your_super_secret_jwt_signing_key_here

# Comma-separated allowed CORS origins for web and developer clients (optional)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# Optional Cloudinary Storage (Free Tier) for permanent dish photo uploads
# When configured, manager-uploaded dish photos persist permanently on Cloudinary CDN across Render restarts.
# If omitted or empty, server defaults safely to local disk storage in uploads/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative single connection URI format:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
