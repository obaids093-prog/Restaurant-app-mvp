{
	"info": {
		"_postman_id": "aura-restaurant-api-collection",
		"name": "AURA Restaurant API (A2)",
		"description": "Complete Postman collection for the AURA Restaurant Express.js + MongoDB REST API.\n\nCovers all 23 endpoints across Health, Auth, Menu, Tables, Reservations, Orders, and Negative Tests.\n\nUses seeded demo accounts from README.md. Run the two login requests first to auto-populate manager and customer tokens.\n\nAssignment 2 — Syed Obaid Ali (9321) — MAD Fall 2026",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "managerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "dishId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "health"]
						},
						"description": "Public health-check endpoint. Returns server status and current timestamp."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Body contains status ok', function () {",
									"    pm.expect(pm.response.json().status).to.eql('ok');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"test.customer@example.com\",\n  \"password\": \"TestPass1\",\n  \"phone\": \"0312-3456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Public registration. Always creates role 'customer' regardless of any role field sent."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Login as Manager",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"farhan.chef@aurabistro.pk\",\n  \"password\": \"Admin1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login with seeded manager account. Saves JWT to managerToken collection variable automatically."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Token is present', function () {",
									"    pm.expect(pm.response.json().token).to.be.a('string');",
									"});",
									"pm.collectionVariables.set('managerToken', pm.response.json().token);"
								]
							}
						}
					]
				},
